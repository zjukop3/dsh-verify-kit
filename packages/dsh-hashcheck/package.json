{
  "name": "dsh-hashcheck",
  "version": "0.1.0",
  "description": "SHA-256 manifests for delivered files: build once, verify anywhere, and say exactly which bytes moved instead of 'looks fine'.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-hashcheck": "./bin/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "sha256", "hash-manifest", "delivery-verification", "交付校验", "文件哈希"],
  "license": "MIT",
  "author": "zjukop3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-verify-kit.git"
  },
  "homepage": "https://github.com/zjukop3/dsh-verify-kit/tree/main/packages/dsh-hashcheck"
}
